#!/usr/bin/env sh
set -e

COMMIT_MSG_FILE="$1"

MESSAGE="$(head -n 1 "${COMMIT_MSG_FILE}")"

MIN_LENGTH=10

# Portable string length (POSIX; avoids bash \${#var})
MESSAGE_LENGTH=$(printf '%s' "${MESSAGE}" | wc -c | tr -d ' ')

if [ "${MESSAGE_LENGTH}" -lt "${MIN_LENGTH}" ]; then
    cat <<EOF

⚠ Commit message is very short.

Consider writing a more descriptive message:

Good:
  add withdrawal fee validation

Less useful:
  fix
  update
  test

This is only a suggestion.
The commit will continue.

EOF
fi

exit 0
