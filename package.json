    "check": "npm run lint && npm run test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0",
    "husky": "^9.1.7",
    "solhint": "^6.2.3"
  }
}
