{
  "name": "vault-core-hardhat",
  "version": "1.0.0",
  "private": true,
  "description": "Solidity Hardhat engineering assessment",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "compile": "hardhat compile",
    "test": "hardhat test",
